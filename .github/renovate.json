{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:daily"
  ],
  "minimumReleaseAge": "7 days",
  "mise": {
    "managerFilePatterns": [
      "/dot_config/mise/conf\\.d/.+\\.toml$/",
      "/dot_config/mise/mise\\.lock$/"
    ]
  },
  "packageRules": [
    {
      "packageNames": ["github:fwdcloudsec/granted"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "groupName": "mise"
    },
    {
      "matchManagers": [
        "dprint"
      ],
      "groupName": "dprint"
    }
  ]
}
